ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-5-5

# Path to the service-account JSON key (never commit it)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# Calendar ID of the dedicated calendar (Calendar settings -> "Integrate calendar"), shared with the service account
GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com
# The ID in the Sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=

SHOP_TZ=America/Los_Angeles
