# Which AI model to use: gemini (free tier) or anthropic (paid)
LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-3.8-flash
# Only if LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# Sign-in file from Google Cloud. Either oauth_client.json (OAuth "Desktop app") or service_account.json.
# Never commit it. With OAuth, run `python -m app.login` once.
GOOGLE_APPLICATION_CREDENTIALS=oauth_client.json
# Calendar ID (Calendar settings -> "Integrate calendar")
GOOGLE_CALENDAR_ID=paste-calendar-id-here
# The ID in the Sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=paste-sheet-id-here

SHOP_TZ=America/Los_Angeles

# Phase 2 (Vapi): a random password; put the same value in Vapi's Custom LLM credential
VAPI_SECRET=

# Optional (voice speed): MINIMAL | LOW | MEDIUM | HIGH. Leave blank for default.
GEMINI_THINKING_LEVEL=

# Optional (voice speed): speak words as Gemini writes them. 1 = on, blank = off.
GEMINI_STREAM=

# Optional fast voice model (free key at console.groq.com): set LLM_PROVIDER=groq and fill these in
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
